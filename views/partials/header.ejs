<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> · The Kondangans</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<% var navCats = locals.navCategories || []; %>

<div class="topbar">
  <div class="container topbar-inner">
    <span>Wedding &amp; event marketplace for local UMKM vendors</span>
    <div class="topbar-links">
      <% if(!currentUser){ %>
        <a href="/register">Become a vendor</a>
      <% } else if(currentUser.role === 'vendor'){ %>
        <a href="/vendor/dashboard">Vendor centre</a>
      <% } else { %>
        <a href="/orders">Track my orders</a>
      <% } %>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32"><circle cx="13" cy="16" r="8"></circle><circle cx="19" cy="16" r="8"></circle></svg>
      </span>
      The Kondangans
    </a>

    <% if(!locals.hideHeaderSearch){ %>
      <form action="/" method="GET" class="header-search">
        <%- icon('search') %>
        <input type="text" name="q" placeholder="Search catering, decoration, souvenirs..." value="<%= locals.query || '' %>" aria-label="Search products">
        <button type="submit">Search</button>
      </form>
    <% } else { %>
      <div class="header-spacer"></div>
    <% } %>

    <div class="header-actions">
      <% if(!currentUser || currentUser.role === 'buyer'){ %>
        <a href="/cart" class="cart-link" aria-label="Cart">
          <%- icon('cart') %>
          <% if(cartCount > 0){ %><span class="cart-badge"><%= cartCount %></span><% } %>
        </a>
      <% } %>

      <% if(currentUser){ %>
        <span class="header-user"><%- icon('user') %><%= currentUser.name %></span>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="btn btn-ghost btn-small">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-ghost btn-small">Log in</a>
        <a href="/register" class="btn btn-primary btn-small">Sign up</a>
      <% } %>
    </div>
  </div>

  <nav class="sub-nav" aria-label="Browse">
    <div class="container sub-nav-inner">
      <% if(currentUser && currentUser.role === 'vendor'){ %>
        <a href="/vendor/dashboard">Dashboard</a>
        <a href="/vendor/products">My Products</a>
        <a href="/vendor/profile">Business Profile</a>
        <a href="/orders">Orders</a>
      <% } else { %>
        <a href="/">All products</a>
        <% navCats.forEach(function(c){ %>
          <a href="/?category=<%= c.id %>"><%= c.name %></a>
        <% }) %>
        <% if(currentUser && currentUser.role === 'buyer'){ %>
          <a href="/orders" class="sub-nav-end">My Orders</a>
        <% } %>
      <% } %>
    </div>
  </nav>
</header>

<main class="site-main">
