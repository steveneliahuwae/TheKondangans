PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Online payments (QRIS) ----
# "mock" = fake sandbox for trying things on your own computer (the QR cannot be paid).
# "midtrans" = real QRIS through Midtrans. Start with your Midtrans SANDBOX keys.
PAYMENT_PROVIDER=mock
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx      # secret, server only, never put it in a web page
# MIDTRANS_IS_PRODUCTION=false                         # true only with your live key
# MIDTRANS_NOTIFICATION_URL=https://your-public-address/payments/webhook   # optional override
PAYMENT_EXPIRY_MINUTES=30

# ---- Production only ----
# NODE_ENV=production        # needs HTTPS, a real SESSION_SECRET (32+ random characters) and a real payment provider
# TRUST_PROXY=1              # set when behind a proxy / load balancer
